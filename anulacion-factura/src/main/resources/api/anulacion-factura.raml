title: OpenAPI de Facturación Electrónica del Grupo 7 MTIS 2024-2025
baseUri: http://localhost:14104/api
description: |
  Contrato OpenAPI para el servicio inciador de composición "Subsanación de factura".
version: 1.0.0
/anulacion-facturas/iniciar:
  post:
    displayName: anulacionFactura
    (amf-summary): Iniciar una tarea de anulación de una factura.
    (amf-tags):
      - Anulacion de factura
    headers:
      WSKey:
        description: Clave de autenticación WSKey
        required: true
        type: string
    body:
      application/json: SolicitudAnulacionFactura
    responses:
      "200":
        description: Anulación de la factura realizada correctamente.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: SuccessResponse
      "400":
        description: Bad Request.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: ErrorResponse
      "401":
        description: Acceso no autorizado.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: ErrorResponse
      "403":
        description: No se tienen los suficientes permisos.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: ErrorResponse
      "404":
        description: Factura no encontrada.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: FacturaNoEncontradaError
      "405":
        description: Método no permitido.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: ErrorResponse
      "500":
        description: Error Interno del Servidor.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: ErrorResponse
      "503":
        description: Servicio No Disponible.
        headers:
          salida?:
            description: Información detallada de la ejecución del método, incluyendo salidas\  correctas y errores.
            type: string
        body:
          application/json: ErrorResponse
    (swagger-router-controller): anulacion-factura
