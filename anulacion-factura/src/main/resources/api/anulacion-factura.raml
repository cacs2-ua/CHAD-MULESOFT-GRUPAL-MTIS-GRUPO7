#%RAML 1.0
types:
  SolicitudAnulacionFactura:
    type: object
    example:
      strict: false
      value:
        numeroFactura: FAC-178965412674769490
        emailEmpresa: facturacion@empresa.com
    properties:
      numeroFactura:
        description: Identificador único de cada factura
        type: string
        required: true
      emailEmpresa:
        description: Email de la empresa que emitió la factura
        type: string
        required: true
  SuccessResponse:
    type: object
    example:
      strict: false
      value:
        mensaje: Operación realizada con éxito.
    properties:
      mensaje?:
        type: string
  ErrorResponse:
    type: object
    example:
      strict: false
      value:
        error: mensaje_de_error
    properties:
      error?:
        type: string
  FacturaNoEncontradaError:
    type: object
    example:
      strict: false
      value:
        error: Factura no encontrada
    properties:
      error?:
        type: string
