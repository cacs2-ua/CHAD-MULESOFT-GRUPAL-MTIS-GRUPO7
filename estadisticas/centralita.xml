		<ee:transform doc:name="Transform Message" doc:id="c48cd975-ead4-47ad-b0b2-471003a32f8f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output text/plain
var d = vars.datosReporte
var totalValid = (d.numeroTotalFacturasValidas default 0) + (d.numeroTotalFacturasSubsanadas default 0)
---
"- STATISTICS REPORT" ++ "\n" ++
"- Company email: " ++ (d.emailEmpresa default "") ++ "\n" ++
"- Start date: " ++ ((d.fechaInicio as DateTime) as String {format: "MMM d, yyyy - HH:mm"}) ++ "\n" ++
"- End date: " ++ ((d.fechaFin    as DateTime) as String {format: "MMM d, yyyy - HH:mm"}) ++ "\n" ++
"- Total number of issued invoices: " ++ (d.numeroTotalFacturasEmitidas default 0) ++ "\n" ++
"- Total sum of all amounts (including VAT): " ++ (d.sumaTotalImportes default 0.0) ++ "\n" ++
"- Total number of valid invoices (corrected or not corrected): " ++ totalValid ++ "\n" ++
"- Total number of valid and not corrected invoices: " ++ (d.numeroTotalFacturasValidas   default 0) ++ "\n" ++
"- Total number of valid and corrected invoices: " ++ (d.numeroTotalFacturasSubsanadas default 0) ++ "\n" ++
"- Total number of canceled invoices: " ++ (d.numeroTotalFacturasAnuladas   default 0) ++ "\n" ++
"- Total number of invalid invoices: " ++ (d.numeroTotalFacturasInvalidas  default 0)
]]></ee:set-payload>
