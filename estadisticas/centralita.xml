<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:jms="http://www.mulesoft.org/schema/mule/jms" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/jms http://www.mulesoft.org/schema/mule/jms/current/mule-jms.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<jms:config name="JMS_Config" doc:name="JMS Config" doc:id="fcc27460-ccdc-45e8-8383-a64a28f9c965" >
		<jms:active-mq-connection username="mtis" password="mtis" >
			<jms:factory-configuration brokerUrl="tcp://localhost:61616" />
		</jms:active-mq-connection>
	</jms:config>
	<wsc:config name="Web_Service_Consumer_Config" doc:name="Web Service Consumer Config" doc:id="ce2c9486-dba8-4eed-8239-9933125b5317" >
		<wsc:connection wsdlLocation="http://localhost:8080/reporteEstadisticas/services/Empresa?wsdl" service="Empresa" port="EmpresaSOAP" address="http://localhost:8080/reporteEstadisticas/services/Empresa/" />
	</wsc:config>
	<db:config name="Database_Config" doc:name="Database Config" doc:id="f80030a8-048d-42f0-a45f-d7799155729d" >
		<db:my-sql-connection host="localhost" port="3306" user="root" password="root" database="facturacion" />
	</db:config>
	<wsc:config name="Calcular_Datos_Reporte_Config" doc:name="Web Service Consumer Config" doc:id="ea9c1178-fcd8-4df6-870c-2bb5372a7244" >
		<wsc:connection wsdlLocation="http://localhost:8080/reporteEstadisticas/services/Reporte?wsdl" service="Reporte" port="ReporteSOAP" address="http://localhost:8080/reporteEstadisticas/services/Reporte/" />
	</wsc:config>
	<wsc:config name="Web_Service_Consumer_Config1" doc:name="Web Service Consumer Config" doc:id="978b48f7-658d-4ed6-b224-d9c29ec924e2" >
		<wsc:connection wsdlLocation="http://localhost:8080/reporteEstadisticas/services/Reporte?wsdl" service="Reporte" port="ReporteSOAP" address="http://localhost:8080/reporteEstadisticas/services/Reporte/" />
	</wsc:config>
	<wsc:config name="prueba" doc:name="Web Service Consumer Config" doc:id="10334601-640e-400d-8c42-c583f890b3cf" >
		<wsc:connection wsdlLocation="http://localhost:8080/reporteEstadisticas/services/Reporte?wsdl" service="Reporte" port="ReporteSOAP" address="http://localhost:8080/reporteEstadisticas/services/Reporte/" />
	</wsc:config>
	<os:object-store name="Object_store" doc:name="Object store" doc:id="fa953003-2498-42ea-981b-0dd71b7ddbe7" persistent="false" />
	<wsc:config name="Reporte_SOAP_Service" doc:name="Web Service Consumer Config" doc:id="23600cd2-4c87-491f-af16-900113dd9f2b" >
		<wsc:connection wsdlLocation="http://localhost:8080/reporteEstadisticas/services/Reporte?wsdl" service="Reporte" port="ReporteSOAP" address="http://localhost:8080/reporteEstadisticas/services/Reporte/" >
			<wsc:web-service-security actor="http://schemas.xmlsoap.org/soap/actor/next" />
		</wsc:connection>
	</wsc:config>
	<flow name="solicitanteGeneracionReportesEstadisticas" doc:id="50275c53-d9aa-448d-8d30-f7b2c0aed5c5" >
		<scheduler doc:name="Scheduler" doc:id="7c475f34-9b5d-40a4-9046-ea9bd7e3f2b8" >
			<scheduling-strategy >
				<fixed-frequency frequency="8000" startDelay="100" />
			</scheduling-strategy>
		</scheduler>
		<logger level="INFO" doc:name="Logger" doc:id="a918ce84-c1e3-4694-9d0c-3527b6da3e90" message="Se solicita la generación de los reportes de estadísticas"/>
		<set-variable value="SOAP_KEY_GRUPO7_FACTURACION_ELECTRONICA" doc:name="Set WSKey variable" doc:id="d6a16a47-39d3-40ca-87e0-e1f8020a1b45" variableName="WSKey"/>
		<logger level="INFO" doc:name="Logger" doc:id="f834069d-afb7-4dd9-bb48-696c6a666fdf" />
		<ee:transform doc:name="Transform Message" doc:id="01f5b52c-5a16-4e77-ab1a-b7819bcb86cf" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
---
solicitud: {
  iniciar: true,
  WSKey: "SOAP_KEY_GRUPO7_FACTURACION_ELECTRONICA"
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<jms:publish doc:name="Publish" doc:id="686b41ac-014c-4e38-9592-7afeb69de2d2" config-ref="JMS_Config" destination="calculador_estadisticas" destinationType="TOPIC" />
	</flow>
	<flow name="calculadorEstadisticas" doc:id="3e4bfd78-32b2-49fb-b2c0-c7da57071480">
		<jms:listener doc:name="On New Message" doc:id="e9fd7342-111b-48c8-9413-b82739603f88" config-ref="JMS_Config" destination="calculador_estadisticas" numberOfConsumers="1">
			<jms:consumer-type>
				<jms:topic-consumer />
			</jms:consumer-type>
		</jms:listener>
		<logger level="INFO" doc:name="Logger" doc:id="465156d1-a8a5-4019-abb8-7214805eab62" message="Inicio del flujo para la generación y envío de los reportes de estadísticas" />
		<ee:transform doc:name="Transform Message" doc:id="ae2de904-544f-48b3-8f62-43982bc6c09b">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
  iniciar: (payload.solicitud.iniciar? default false) as Boolean,
  WSKey  : payload.solicitud.WSKey
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<set-variable value="#[payload.iniciar]" doc:name="Set Iniciar Variable" doc:id="ad966077-ef8a-4f8a-b649-3fe56541945c" variableName="iniciar" />
		<set-variable value="#[payload.WSKey]" doc:name="Set WSKey" doc:id="a00f3b32-5385-4ab0-bb8b-8b899f010233" variableName="WSKey" />
		<db:select doc:name="Select RealWSKey" doc:id="46c2d136-e963-4eb3-9b74-92d9a83f223c" config-ref="Database_Config">
			<db:sql><![CDATA[SELECT * FROM parametros;]]></db:sql>
		</db:select>
		<set-variable value="#[payload[0].valor]" doc:name="Set RealWSKey" doc:id="e67605f5-1b29-4aba-8662-35e0424b49ab" variableName="RealWSKey" />
		<logger level="INFO" doc:name="Logger" doc:id="deab18b2-3454-4c4c-ad46-2aa2159ffa61" message="Comparamos la WSKey con la original" />
		<choice doc:name="Choice" doc:id="44ed10df-d27d-4998-bd36-e67a0154b37f">
			<when expression="#[vars.WSKey != vars.RealWSKey]">
				<raise-error doc:name="Raise error" doc:id="a7475493-9e64-434e-a91d-1753ac2495a0" type="ACCESS:UNAUTHORIZED" description="ERROR: Operacion no autorizada." />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Logger" doc:id="68e31939-cbd2-4372-9d6e-4e8c5a23b87c" message="Acceso autorizado para realizar la operación" />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="Logger" doc:id="0de9067b-bfd6-4bf9-9af6-bb483aa69da8" message="Almacenamos la WSKey en un almacén global para que sea accesible por todos los flujos"/>
		<os:store doc:name="Store WSKey" doc:id="c69f5aaa-48c3-4359-b26b-bf18960a2fb4" objectStore="Object_store" key="#['WSKey']" >
			<os:value ><![CDATA[#[vars.WSKey]]]></os:value>
		</os:store>
		<logger level="INFO" doc:name="Logger" doc:id="93cb0556-2642-4b30-87b7-d5a314fe0627" message="Si iniciar es true, entonces iniciamos el proceso de generación y envío de los reportes de estadísticas" />
		<choice doc:name="Choice" doc:id="0e77918f-362b-4702-8514-3c7f7a2f5eb4">
			<when expression="#[vars.iniciar == true]">
				<db:select doc:name="Select" doc:id="25c76ea3-be55-46ee-9f1e-130893bb7f50" config-ref="Database_Config">
					<db:sql ><![CDATA[SELECT email FROM empresas WHERE id=1;]]></db:sql>
				</db:select>
				<set-variable value="#[payload[0].email]" doc:name="Set emailEmpresaPrincipal" doc:id="7c371b25-6f14-4ece-be25-989fbdcb08a6" variableName="emailEmpresaPrincipal"/>
				<ee:transform doc:name="Transform Message" doc:id="810e154f-2386-4797-b033-5f3b7ab4696b">
					<ee:message>
						<ee:set-payload><![CDATA[import * from dw::core::Dates
output application/java
---
atBeginningOfMonth(now())]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<set-variable value="#[payload]" doc:name="Set fechaInicio" doc:id="c82b5b67-4542-4555-9b1b-6d8ba630f37a" variableName="fechaInicio"/>
				<ee:transform doc:name="Transform Message" doc:id="58f3117c-2a40-4d9c-a9f7-dd8056e7e4dc">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
import * from dw::core::Dates
output application/java
---
atBeginningOfMonth(now() + |P1M|)]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<set-variable value="#[payload]" doc:name="Set fechaFin" doc:id="c877f8dd-8698-4043-b736-bd542809c922" variableName="fechaFin"/>
				<logger level="INFO" doc:name="Logger" doc:id="575e9ba0-c77c-462c-9648-1d8173a35583" message="Transformamos el payload para consumir a la operacion SOAP 'consultarTodasEmpresas'" />
				<ee:transform doc:name="Transform Message" doc:id="4a1cc23e-a75a-450d-a224-ad6e99cb5c2c">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/xml
ns emp http://www.example.org/Empresa/
---
emp#consultarTodasEmpresas: {
  WSKey: vars.WSKey
}
]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<wsc:consume operation="consultarTodasEmpresas" doc:name="Consume consultar todas empresas" doc:id="ccba6f6e-985a-491f-bc8f-db894034625d" config-ref="Web_Service_Consumer_Config" />
				<logger level="INFO" doc:name="Logger" doc:id="a4b0f709-d540-4cbc-bb88-6de1a0c5003a" message="Transformamos el payload en una lista de objetos JAVA" />
				<ee:transform doc:name="Transform Message" doc:id="26fe2895-537a-4b57-93f6-ea7772763bb3">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/java
ns ns3 http://www.example.org/Empresa/
---
(payload.body.ns3#consultarTodasEmpresasResponse.*empresas default [])]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Logger" doc:id="32462662-37d5-479d-92c0-da1cca37954e" />
				<foreach doc:name="For Each" doc:id="f44e1a55-03c0-463f-8100-4f7d3aa41d2f" collection="#[payload]">
					<choice doc:name="Choice" doc:id="6f676bfc-b305-4ecf-bfc8-f6e01af336d6" >
						<when expression="#[payload.email != vars.emailEmpresaPrincipal]">
							<logger level="INFO" doc:name="Logger" doc:id="6e0a651e-c569-44c8-a854-df5c4bbdee60" />
							<ee:transform doc:name="Transform Message" doc:id="d70a251c-19d2-4c4a-b655-d6e3f8afcb93" >
								<ee:message >
									<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
ns rep http://www.example.org/Reporte/
---
rep#calcularDatosReporte: {
  datosEntrada: {
    fechaInicio: vars.fechaInicio,
    fechaFin: vars.fechaFin,
    emailEmpresa: payload.email
  },
  WSKey: vars.WSKey
}
]]></ee:set-payload>
								</ee:message>
							</ee:transform>
							<wsc:consume doc:name="Consume" doc:id="fe3887be-f179-4d5b-91f1-f31ffa19c684" config-ref="prueba" operation="calcularDatosReporte"/>
							<logger level="INFO" doc:name="Logger" doc:id="42be12ac-774c-46b0-b3bb-4a5e7ee169db" />
							<logger level="INFO" doc:name="Logger" doc:id="1b1e7009-03f7-47fa-a9c9-3b7935045c14" />
							<jms:publish doc:name="Publish" doc:id="fff7e851-14d7-44ea-9e89-115d89ce191b" config-ref="JMS_Config" destination="almacenador_reportes_estadisticas" destinationType="TOPIC" >
								<jms:message >
									<jms:body ><![CDATA[#[payload.body]]]></jms:body>
								</jms:message>
							</jms:publish>
						</when>
						<otherwise >
							<logger level="INFO" doc:name="Logger" doc:id="8afebc03-454e-44ae-a1ab-6b7e802a475e" message="Se ignora la empresa con id = 1 ya que dicha empresa es la empresa principal"/>
						</otherwise>
					</choice>
				</foreach>
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Logger" doc:id="cfcc7699-b256-459e-9bec-6eec329cde28" message="Iniciar es false" />
			</otherwise>
		</choice>
	</flow>
	<flow name="almacenadorReporteEstadisticas" doc:id="ec4f4662-6777-4ab4-b284-a443349c9718" >
		<jms:listener doc:name="On New Message" doc:id="65669fde-f4cb-4c03-8b3b-4d0c0ec569f1" config-ref="JMS_Config" destination="almacenador_reportes_estadisticas" numberOfConsumers="1" >
			<jms:consumer-type >
				<jms:topic-consumer />
			</jms:consumer-type>
		</jms:listener>
		<logger level="INFO" doc:name="Logger" doc:id="2375a1bc-986b-4460-b45f-583a31fb42cf" message="Comienzo de la generación de los reportes de estadísticas"/>
		<ee:transform doc:name="Transform Message" doc:id="c37a594c-5dd3-4bcb-b04e-a602ab080773" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
ns ns1 http://www.example.org/Reporte/

var dr = payload.ns1#calcularDatosReporteResponse.datosReporte

---
{
    fechaInicio: dr.fechaInicio as DateTime,
    fechaFin: dr.fechaFin as DateTime,
    numeroTotalFacturasEmitidas: dr.numeroTotalFacturasEmitidas as Number,
    sumaTotalImportes: dr.sumaTotalImportes as Number,
    numeroTotalFacturasValidas: dr.numeroTotalFacturasValidas as Number,
    numeroTotalFacturasSubsanadas: dr.numeroTotalFacturasSubsanadas as Number,
    numeroTotalFacturasAnuladas: dr.numeroTotalFacturasAnuladas as Number,
    numeroTotalFacturasInvalidas: dr.numeroTotalFacturasInvalidas as Number,
    emailEmpresa: dr.emailEmpresa
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="ca9d5acd-dbd3-4939-a9cf-b33e74c11503" message="Se guardan los datos del reporte de estadísticas en una variable JAVA que actúa como un diccionario"/>
		<set-variable value="#[payload]" doc:name="Set datosReporte" doc:id="bd4d685b-93c4-45d7-8f3e-6901c3d8faf1" variableName="datosReporte"/>
		<logger level="INFO" doc:name="Logger" doc:id="ba8d037f-377e-44df-bf9f-cac4d380557f" message="Recuperamos la WSKey del almacén global y la almacenamos en una variable local"/>
		<os:retrieve doc:name="Retrieve WSKey" doc:id="bc7a1070-33ae-498c-84e2-85ad37eeb4a0" key="#['WSKey']" objectStore="Object_store"/>
		<set-variable value="#[payload]" doc:name="Set WSKey" doc:id="cd7d5acf-573d-41bd-a80a-a7352314dc55" variableName="WSKey"/>
		<logger level="INFO" doc:name="Logger" doc:id="c1e2135b-7256-42dc-8069-88faa8e8a8bc" message="Transformamos el payload para consumir la operación SOAP 'guardarReporteEnBD'"/>
		<ee:transform doc:name="Transform Message" doc:id="cf377379-53e2-4304-aa20-309d27387615" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
ns rep http://www.example.org/Reporte/
---
rep#guardarReporteEnBD: {
	datosEntrada: {
		fechaInicio: vars.datosReporte.fechaInicio,
		fechaFin: vars.datosReporte.fechaFin,
		numeroTotalFacturasEmitidas: vars.datosReporte.numeroTotalFacturasEmitidas,
		sumaTotalImportes: vars.datosReporte.sumaTotalImportes,
		numeroTotalFacturasValidas: vars.datosReporte.numeroTotalFacturasValidas,
		numeroTotalFacturasSubsanadas: vars.datosReporte.numeroTotalFacturasSubsanadas,
		numeroTotalFacturasAnuladas: vars.datosReporte.numeroTotalFacturasAnuladas,
		numeroTotalFacturasInvalidas: vars.datosReporte.numeroTotalFacturasInvalidas,
		emailEmpresa: vars.datosReporte.emailEmpresa
	},
	WSKey: vars.WSKey
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="d0d15341-052f-4d03-8f9c-7c5a5dae4f4f" message="Se almacena el reporte en la base de datos"/>
		<wsc:consume operation="guardarReporteEnBD" doc:name="Guardar reporte en BD" doc:id="95ed229f-5fcd-4474-bbdb-2dc7e6330469" config-ref="Reporte_SOAP_Service"/>
		<logger level="INFO" doc:name="Logger" doc:id="481d2d38-faa9-4220-a2ab-fbbfdbf273e9" message="#['Reporte de estadísticas creado y almacenado correctamente para la empresa con email: ' ++ (vars.datosReporte.emailEmpresa)]"/>
		<jms:publish doc:name="Publish" doc:id="77b5587d-936d-488a-8619-1f171731a13d" config-ref="JMS_Config" destination="exportador_reportes_estadisticas" destinationType="TOPIC" >
			<jms:message >
				<jms:body ><![CDATA[#[payload.body]]]></jms:body>
			</jms:message>
		</jms:publish>
	</flow>
	<flow name="exportadorReportesEstadisticas" doc:id="00c1b4d0-1a9d-4ca4-95f2-f0ce82f8d420" >
		<jms:listener doc:name="On New Message" doc:id="489f424e-9f15-4fc3-9f2c-a294a8e09209" config-ref="JMS_Config" destination="exportador_reportes_estadisticas" numberOfConsumers="1" >
			<jms:consumer-type >
				<jms:topic-consumer />
			</jms:consumer-type>
		</jms:listener>
		<logger level="INFO" doc:name="Logger" doc:id="deeb4e95-eced-48e2-a26a-3c2e92e95412" />
	</flow>
</mule>
